{
  "compilerOptions": {
    "target": "es6", 
    "module": "commonjs",  // Voltar para CommonJS
    "moduleResolution": "node",  // Configuração para resolver módulos padrão
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./build",
    "rootDir": "./src",
    "types": ["node", "superagent"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "jest.config.ts", "build"]
}
